{
  "name": "pmdt",
  "version": "0.1.0",
  "author": {
    "name": "Piotr Szmurlo"
  },
  "description": "Piotr's markdown tracker — each task is a git-friendly .md file",
  "keywords": [
    "task-manager",
    "markdown",
    "kanban",
    "cli",
    "bun"
  ],
  "homepage": "https://github.com/piotrszmurlo/pmdt",
  "repository": {
    "type": "git",
    "url": "https://github.com/piotrszmurlo/pmdt.git"
  },
  "license": "MIT",
  "bin": {
    "pmdt": "./dist/pmdt.js"
  },
  "files": [
    "dist/pmdt.js"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun run scripts/build.ts",
    "prepublishOnly": "bun run build && bun test",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5.4.0"
  }
}
